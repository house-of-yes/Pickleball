#!/usr/bin/env bash
#
# Pickleball Patch Bridge — apply a unified diff to the current git repo,
# commit it, and emit a reliable machine-readable report.
#
# USAGE (Termux or any POSIX shell):
#   # Default: read unified diff from STDIN (recommended)
#   patch-bridge -m "commit subject" < /path/to/changes.diff
#
#   # Or from a file:
#   patch-bridge -i /path/to/changes.diff -m "commit subject"
#
#   # Dry run (validate only, no changes):
#   patch-bridge -n < diff.patch
#
#   # Show help:
#   patch-bridge -h
#
# OUTPUT:
#   Writes JSON to stdout and to $REPO/.Pickleball/bridge/last_run.json like:
#   {
#     "ok": true,
#     "repo": "/abs/path/to/repo",
#     "commit": "abcd1234...",
#     "files_changed": 3,
#     "insertions": 12,
#     "deletions": 4,
#     "message": "commit subject",
#     "ts": "2025-09-27T12:34:56-07:00"
#   }
#
# NOTES:
#   - Requires git. Applies with `git apply --3way --index` for resilience.
#   - Auto-fixes whitespace, preserves modes when possible via index.
#   - If apply fails, no commit is created; JSON { ok:false, error:"..." } is emitted.
#   - Intended to be invoked by you locally. This script never fetches or pushes.
#   - Place this file at Pickleball/scripts/patch-bridge and `chmod +x` it.
set -euo pipefail

print_help() {
  sed -n '1,70p' "$0" | sed 's/^# \{0,1\}//'
}

err() { printf '%s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

# Parse args
DIFF_FILE=""
MSG=""
DRYRUN="false"

while getopts ":i:m:nh" opt; do
  case "$opt" in
    i) DIFF_FILE="$OPTARG" ;;
    m) MSG="$OPTARG" ;;
    n) DRYRUN="true" ;;
    h) print_help; exit 0 ;;
    \?) die "Unknown option: -$OPTARG (use -h for help)";;
    :) die "Option -$OPTARG requires an argument";;
  esac
done
shift $((OPTIND-1))

# Ensure we are inside a git repo
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  die "Not inside a git repository."
fi
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Prepare bridge state dir
STATE_DIR="$REPO_ROOT/.Pickleball/bridge"
mkdir -p "$STATE_DIR"

timestamp() {
  # RFC3339-ish with local TZ
  date +"%Y-%m-%dT%H:%M:%S%z" | sed 's/\(..\)$/:\1/'
}

# Read diff into a temp file
TMP_DIFF="$(mktemp -t xcal_patch.XXXXXX.patch)"
cleanup() { rm -f "$TMP_DIFF" >/dev/null 2>&1 || true; }
trap cleanup EXIT

if [[ -n "$DIFF_FILE" ]]; then
  [[ -f "$DIFF_FILE" ]] || die "Diff file not found: $DIFF_FILE"
  cp "$DIFF_FILE" "$TMP_DIFF"
else
  # Read from stdin
  if [ -t 0 ]; then
    die "No diff provided. Pipe a unified diff on stdin or use -i <file>."
  fi
  cat > "$TMP_DIFF"
fi

# Basic sanity check: looks like a unified diff?
if ! grep -qE '^(--- |\+\+\+ |diff --git )' "$TMP_DIFF"; then
  die "Input does not look like a unified diff. Expect lines starting with 'diff --git' or '---'/'+++'."
fi

# Save pre-apply state for diagnostics
PRE_HEAD="$(git rev-parse --short HEAD 2>/dev/null || echo '0000000')"

# Validate apply
APPLY_ARGS=(--3way --whitespace=fix --index)
if ! git apply --check "${APPLY_ARGS[@]}" "$TMP_DIFF" 2>"$STATE_DIR/last_apply_check.err"; then
  jq -n --arg repo "$REPO_ROOT" \
        --arg ts "$(timestamp)" \
        --arg error "$(tr '\n' ' ' < "$STATE_DIR/last_apply_check.err")" \
        '{ok:false, repo:$repo, ts:$ts, error:$error}' \
    | tee "$STATE_DIR/last_run.json"
  exit 2
fi

if [[ "$DRYRUN" == "true" ]]; then
  # Summarize what WOULD change
  # Try an index-only sandbox by stashing; simpler: emit a generic success preview
  jq -n --arg repo "$REPO_ROOT" \
        --arg ts "$(timestamp)" \
        '{ok:true, repo:$repo, ts:$ts, dryrun:true, note:"Patch validated (--check) but not applied."}' \
    | tee "$STATE_DIR/last_run.json"
  exit 0
fi

# Apply patch
if ! git apply "${APPLY_ARGS[@]}" "$TMP_DIFF" 2>"$STATE_DIR/last_apply.err"; then
  jq -n --arg repo "$REPO_ROOT" \
        --arg ts "$(timestamp)" \
        --arg error "$(tr '\n' ' ' < "$STATE_DIR/last_apply.err")" \
        '{ok:false, repo:$repo, ts:$ts, error:$error}' \
    | tee "$STATE_DIR/last_run.json"
  exit 3
fi

# If nothing actually changed (already applied), short-circuit
if git diff --cached --quiet; then
  jq -n --arg repo "$REPO_ROOT" \
        --arg ts "$(timestamp)" \
        --arg msg "${MSG:-}" \
        --arg note "No changes staged (patch may already be applied)" \
        '{ok:true, repo:$repo, ts:$ts, commit:null, files_changed:0, insertions:0, deletions:0, message:$msg, note:$note}' \
    | tee "$STATE_DIR/last_run.json"
  exit 0
fi

# Commit staged changes
COMMIT_MSG="${MSG:-bridge: apply patch}"
if ! git commit -m "$COMMIT_MSG" --no-verify >/dev/null 2>"$STATE_DIR/last_commit.err"; then
  jq -n --arg repo "$REPO_ROOT" \
        --arg ts "$(timestamp)" \
        --arg error "$(tr '\n' ' ' < "$STATE_DIR/last_commit.err")" \
        '{ok:false, repo:$repo, ts:$ts, error:$error}' \
    | tee "$STATE_DIR/last_run.json"
  exit 4
fi

NEW_HEAD="$(git rev-parse HEAD)"
SHORT_HEAD="$(git rev-parse --short HEAD)"

# Diff stats for the commit
STATS="$(git show --numstat --format= "" "$NEW_HEAD")"
# numstat lines: <insertions>\t<deletions>\t<file>
FILES_CHANGED=$(printf "%s\n" "$STATS" | awk 'NF==3{c++} END{print c+0}')
INSERTIONS=$(printf "%s\n" "$STATS" | awk 'NF==3{i+=$1} END{print i+0}')
DELETIONS=$(printf "%s\n" "$STATS" | awk 'NF==3{d+=$2} END{print d+0}')

# Emit JSON report
jq -n \
  --arg repo "$REPO_ROOT" \
  --arg commit "$NEW_HEAD" \
  --arg short "$SHORT_HEAD" \
  --arg ts "$(timestamp)" \
  --arg msg "$COMMIT_MSG" \
  --arg pre "$PRE_HEAD" \
  --arg files_changed "$FILES_CHANGED" \
  --arg insertions "$INSERTIONS" \
  --arg deletions "$DELETIONS" \
  '{
     ok:true,
     repo:$repo,
     commit:$commit,
     short:$short,
     ts:$ts,
     message:$msg,
     parent:$pre,
     files_changed: ($files_changed|tonumber),
     insertions: ($insertions|tonumber),
     deletions: ($deletions|tonumber)
   }' | tee "$STATE_DIR/last_run.json"

exit 0
