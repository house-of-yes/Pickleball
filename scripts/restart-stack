#!/usr/bin/env bash
# Pickleball Restart Script — clean teardown, bootstrap, and smoke test.

set -euo pipefail

# -----------------------
# Repo root resolution (Termux-safe)
# -----------------------
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

# -----------------------
# Paths / State
# -----------------------
STATE_DIR="${STATE_DIR:-$HOME/.Pickleball/bridge}"
PIDFILE="$STATE_DIR/listener.pid"
FIFO="$STATE_DIR/inbox.patch"
LOG="$STATE_DIR/listener.log"

ts() { date +"%Y-%m-%dT%H:%M:%S%z" | sed 's/\(..\)$/:\1/'; }
log() { echo "[$(ts)] $*"; }

# -----------------------
# Teardown
# -----------------------
log "Stopping any running bridge-listener..."
pkill -f scripts/bridge-listener 2>/dev/null || true

if [[ -f "$PIDFILE" ]]; then
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    log "Killing pid from pidfile ($pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 1 || true
  fi
fi

log "Clearing PID and FIFO..."
rm -f "$PIDFILE" "$FIFO"

# -----------------------
# Bootstrap
# -----------------------
log "Running bootstrap..."
if scripts/bootstrap; then
  log "Bootstrap completed."
else
  log "Bootstrap FAILED."
  exit 1
fi

# -----------------------
# Smoke Test
# -----------------------
if [[ ! -x scripts/listener-smoke-test ]]; then
  log "Smoke test script missing or not executable: scripts/listener-smoke-test"
  exit 1
fi

log "Running listener-smoke-test..."
if scripts/listener-smoke-test; then
  log "Stack restart + smoke test PASSED"
  exit 0
else
  log "Stack restart completed but smoke test FAILED"
  [[ -f "$LOG" ]] && { log "Recent listener log tail:"; tail -n 50 "$LOG" || true; }
  exit 1
fi
