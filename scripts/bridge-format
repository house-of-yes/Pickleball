#!/usr/bin/env bash
# Print the last applied artifact in a chosen fence for “colored confirm” echo.
# Usage: bridge-format diff|bash|python|text
set -euo pipefail
STATE_DIR="$HOME/.Pickleball/bridge"
ART="$STATE_DIR/last_applied.txt"
LANG="${1:-diff}"

if [[ ! -f "$ART" ]]; then
  echo "[bridge-format] No last_applied.txt found." >&2
  exit 1
fi

printf '```%s\n' "$LANG"
cat "$ART"
printf '\n```\n'
