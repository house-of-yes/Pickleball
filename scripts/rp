#!/usr/bin/env bash
# rp — forward a fenced path+file block to THIS repo's listener FIFO, unchanged.
# Usage:
#   cat payload.txt | scripts/rp
#   (paste then Ctrl-D): scripts/rp

set -euo pipefail
IFS=$'\n\t'

# Resolve this repo root and name
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
REPO_NAME="$(basename -- "$REPO_ROOT")"

# Locate FIFO: alias only (listener binds to ~/.Pickleball/bridge/inbox.patch)
ALIAS_FIFO="${HOME}/.Pickleball/bridge/inbox.patch"

if [[ ! -p "$ALIAS_FIFO" ]]; then
  echo "[ERR] No bridge FIFO found at $ALIAS_FIFO. Start scripts/bridge-listener first." >&2
  exit 1
fi

# Capture stdin exactly; require a fenced block with path as first in-block line
TMP="$(mktemp -p "${REPO_ROOT}/var/tmp" rp.XXXXXX 2>/dev/null || mktemp)"
trap 'rm -f "$TMP" 2>/dev/null || true' EXIT

cat > "$TMP"

# Minimal validation
if ! awk '
  BEGIN{f=0;p=0}
  /^```/ && f==0 {f=1; next}
  f==1 && length($0)>0 {p=1; exit}
  END{exit !(f&&p)}
' "$TMP" >/dev/null 2>&1; then
  echo "[ERR] Input must be a fenced block with the target path as the first line inside." >&2
  exit 2
fi

# Send to FIFO exactly as received
cat "$TMP" > "$ALIAS_FIFO"
echo "[ok] sent to listener"
