#!/data/data/com.termux/files/usr/bin/bash
# One-shot RP wrapper: consumes clipboard once, clears it, uses rp.tmp, cleans up.
set -euo pipefail

CLIP="$(termux-clipboard-get || true)"
if [ -z "${CLIP}" ]; then
  echo "RP: clipboard empty."
  exit 1
fi

mkdir -p bin
printf '%s' "${CLIP}" > bin/rp.tmp

# Clear clipboard *before* invoking the original rp
termux-clipboard-set "" || true

# Call the original rp (renamed to rp.orig) so logic stays intact
"$(dirname $0)/rp.orig"

# Clean up
rm -f bin/rp.tmp
