# Pickleball daemon sample environment configuration

# Absolute path to the repo root (defaults to current working directory)
EXCALIBUR_WORKSPACE=/data/data/com.termux/files/home/Code/your-repo

# Comma-separated path prefixes allowed to change (optional; default = unrestricted)
EXCALIBUR_ALLOWLIST=.

# Test command to run after file apply (default: "PYTHONPATH=. pytest -q")
EXCALIBUR_TEST_CMD=PYTHONPATH=. pytest -q

# Max lines of test output to include in summary (default: 200)
EXCALIBUR_MAX_SUMMARY_LINES=200

# Default for ApplyRequest.dry_run (true/false; default: false)
EXCALIBUR_DRY_RUN_DEFAULT=false

# Path to the event log file (default: .ide-bridge.log in workspace)
EXCALIBUR_LOG_FILE=.ide-bridge.log

# Port to bind the FastAPI server (default: 8765)
PORT=8765

# Test configuration
EXCALIBUR_TEST_SCOPE=smart         # smart | full | changed
EXCALIBUR_TEST_CMD=pytest          # or your test runner
EXCALIBUR_TEST_TIMEOUT=30          # seconds
EXCALIBUR_TEST_SELECTORS=          # comma-sep; override auto detection
EXCALIBUR_PYTEST_ARGS=             # extra args; e.g. -n auto
