#!/usr/bin/env bash
set -euo pipefail
REPO="$HOME/Pickleball"
RT="$HOME/var/Pickleball"; RUN="$RT/run"; LOG="$RT/logs"
Q="$RUN/live_queue.sh"; O="$RUN/live_offset_bytes"
mkdir -p "$RUN" "$LOG"; touch "$Q" "$O"
printf '[live_runner] start %s\n' "$(date -Is)" >> "$LOG/live_runner.log"

while true; do
  off="$(cat "$O" 2>/dev/null || echo 0)"; [ -z "$off" ] && off=0
  size=$(wc -c < "$Q" 2>/dev/null || echo 0)
  if [ "$size" -le "$off" ]; then sleep 0.2; continue; fi

  chunk="$(dd if="$Q" bs=1 skip="$off" status=none 2>/dev/null || true)"
  block="$(printf '%s' "$chunk" | awk '/^### HOTDROP-BEGIN/{f=1} f{print} /^### HOTDROP-END/{exit}')"
  [ -z "$block" ] && { sleep 0.1; continue; }

  echo "===== TERMUX HOTDROP ====="
  printf '%s\n' "$block"
  tmp="$(mktemp)"; printf '%s\n' "$block" > "$tmp"
  if bash "$tmp"; then
    echo "===== END HOTDROP (0) ====="
    printf '[live_runner] ok %s\n' "$(date -Is)" >> "$LOG/live_runner.log"
  else
    rc=$?; echo "===== END HOTDROP ($rc) ====="
    printf '[live_runner] fail %s rc=%s\n' "$(date -Is)" "$rc" >> "$LOG/live_runner.log"
  fi
  used=$(printf '%s' "$block" | wc -c)
  echo $((off+used)) > "$O"
  rm -f "$tmp"
done
