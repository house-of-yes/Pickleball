#!/usr/bin/env bash
set -euo pipefail
RT="$HOME/var/Pickleball"; RUN="$RT/run"; LOG="$RT/logs"
FIFO="$RUN/hotdrop_in.fifo"; Q="$RUN/live_queue.sh"
mkdir -p "$RUN" "$LOG"; touch "$Q"; rm -f "$FIFO"; mkfifo "$FIFO"
printf '[hotdrop_subscribe] start %s\n' "$(date -Is)" >> "$LOG/hotdrop_subscribe.log"

awk 'BEGIN{in=0}
     /^### HOTDROP-BEGIN/{in=1;buf=$0"\n";next}
     { if(in) buf=buf $0 "\n" }
     /^### HOTDROP-END/{ if(in){ print buf; fflush(); in=0; buf="" } }' < "$FIFO" >> "$Q"
