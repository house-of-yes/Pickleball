#!/data/data/com.termux/files/usr/bin/bash
# One-shot RP wrapper: consume clipboard once, clear it, run original, clean up.
set -euo pipefail

# Pull clipboard
CLIP="$(termux-clipboard-get || true)"
if [ -z "${CLIP}" ]; then
  echo "RP: clipboard empty."
  exit 1
fi

# Write one-shot tmp where you usually invoke rp (repo root expected)
mkdir -p bin
printf '%s' "${CLIP}" > bin/rp.tmp

# Clear clipboard BEFORE invoking original to avoid stale double-fires
termux-clipboard-set "" || true

# Call the original script (now rp.orig) from the same dir
"$(dirname "$0")/rp.orig"

# Clean up
rm -f bin/rp.tmp
