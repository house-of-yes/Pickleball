#!/data/data/com.termux/files/usr/bin/bash
# Pickleball CLI wrapper (xcal)

set -euo pipefail

API_BASE="${EX_HOST:-127.0.0.1}:${EX_PORT:-8765}"
HOST="http://$API_BASE"

cmd="${1:-}"
shift || true

case "$cmd" in
  sendfile)
    file="${1:?usage: xcal sendfile <path>}"
    curl -s -X POST \
      -H "Content-Type: text/plain; charset=utf-8" \
      --data-binary @"$file" \
      "$HOST/apply"
    ;;
  get)
    file="${1:?usage: xcal get <path>}"
    curl -s "$HOST/get?path=$file"
    ;;
  health)
    curl -s "$HOST/health"
    ;;
  version)
    curl -s "$HOST/version"
    ;;
  *)
    echo "Usage: xcal {sendfile|get|health|version} [args...]"
    exit 1
    ;;
esac
