#!/usr/bin/env bash
# Simple archive: tar selected paths and drop result into Downloads (Termux-aware).
# Usage: tools/archive [PATH ...]
# If no paths are given, archives the repo root (".")

set -euo pipefail
IFS=$'\n\t'

# --- Find repo root (prefer git; fallback to script/.. ) ---
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
REPO_NAME="$(basename -- "$REPO_ROOT" | tr -cd 'A-Za-z0-9._-')"

# --- Choose output dir (Downloads first, then repo/var/archives) ---
choose_out() {
  for d in "$HOME/storage/downloads" "$HOME/Download" "$HOME/Downloads"; do
    [[ -d "$d" && -w "$d" ]] && { echo "$d"; return; }
  done
  echo "$REPO_ROOT/var/archives"
}
OUT_DIR="$(choose_out)"
mkdir -p "$OUT_DIR" "$REPO_ROOT/var/tmp"

# --- Inputs ---
if [[ $# -eq 0 ]]; then
  ARGS=(".")
else
  ARGS=("$@")
fi

# --- Helpers ---
utcstamp(){ date -u +"%Y%m%dT%H%M%SZ"; }

# Base name: <repo>-<stamp>-archive
STAMP="$(utcstamp)"
BASE="${REPO_NAME}-${STAMP}-archive"
ARCHIVE_PATH="${OUT_DIR}/${BASE}.tgz"

# --- Temp staging (for MANIFEST and any external files) ---
TMPDIR="$(mktemp -d -p "${REPO_ROOT}/var/tmp" arch.XXXXXX 2>/dev/null || mktemp -d)"
trap 'rm -rf "$TMPDIR" 2>/dev/null || true' EXIT
STAGE="$TMPDIR/stage"; mkdir -p "$STAGE"
EXTERNAL="$TMPDIR/external"; mkdir -p "$EXTERNAL"

# --- Build MANIFEST ---
MANIFEST="$STAGE/MANIFEST.txt"
{
  echo "Archive manifest"
  echo "Repo:   $REPO_ROOT"
  echo "Date:   $(date -u -Iseconds)"
  echo "Out:    $OUT_DIR"
  echo "Inputs:"
  for p in "${ARGS[@]}"; do
    if [[ -d "$p" ]]; then
      printf '  [dir]  %s\n' "$(CDPATH= cd -- "$p" && pwd -P)"
    else
      printf '  [file] %s\n' "$(CDPATH= cd -- "$(dirname -- "$p")" && pwd -P)/$(basename -- "$p")"
    fi
  done
} > "$MANIFEST"

# --- Build file list for repo-internal paths; mirror externals ---
LISTFILE="$TMPDIR/list.txt"; : > "$LISTFILE"
EXT_ADDED=0
for p in "${ARGS[@]}"; do
  abs="$(CDPATH= cd -- "$(dirname -- "$p")" && pwd -P)/$(basename -- "$p")"
  case "$abs" in
    "$REPO_ROOT"/*|"$REPO_ROOT")
      rel="${abs#"$REPO_ROOT"/}"; [[ -z "$rel" ]] && rel="."
      echo "./$rel" >> "$LISTFILE"
      ;;
    *)
      cp -a "$abs" "$EXTERNAL"/
      EXT_ADDED=1
      ;;
  esac
done

# --- Build tarball ---
set +e
if (( EXT_ADDED == 1 )); then
  tar -czf "$ARCHIVE_PATH" \
    -C "$REPO_ROOT" -T "$LISTFILE" \
    -C "$STAGE" MANIFEST.txt \
    -C "$TMPDIR" external 2>/dev/null
else
  tar -czf "$ARCHIVE_PATH" \
    -C "$REPO_ROOT" -T "$LISTFILE" \
    -C "$STAGE" MANIFEST.txt 2>/dev/null
fi
STATUS=$?
set -e

if (( STATUS != 0 )); then
  echo "[ERR] tar failed: $ARCHIVE_PATH" >&2
  exit 3
fi

echo "$ARCHIVE_PATH"
