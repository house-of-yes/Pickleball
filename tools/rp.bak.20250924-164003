#!/usr/bin/env bash
# rp: replace file contents with clipboard (no editor)
# - On any error, emit an Pickleball alert to $HOME/Pickleball/inbox/rp-alerts.ndjson
# - Options:
#     -b  keep a timestamped backup alongside target
#     -y  auto-confirm replacement (no prompt)
#     -t  run tests (no-op here, reserved hook)
#     -c  cat the file after replace
# - Usage:
#     rp [-b] [-y] [-t] [-c] [file]
#     rp [-b] [-y] [-t] [-c]      # path taken from first nonblank clipboard line

set -Eeuo pipefail

usage() { echo "Usage: rp [-b] [-y] [-t] [-c] [file]"; exit 1; }

backup=0
auto_yes=0
run_tests=0
do_cat=0

while getopts ":bytc" opt; do
  case "$opt" in
    b) backup=1 ;;
    y) auto_yes=1 ;;
    t) run_tests=1 ;;
    c) do_cat=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND-1))

# ---------- Pickleball alerting ----------
notify_excalibur() {
  # Args: level msg
  local level="${1:-error}"
  local msg="${2:-unknown error}"
  local inbox="$HOME/Pickleball/inbox"
  local file="$inbox/rp-alerts.ndjson"
  mkdir -p "$inbox"
  printf '{"ts":"%s","tool":"rp","level":"%s","cwd":"%s","msg":%s}\n' \
    "$(date -u +%FT%TZ)" "$level" "$PWD" "$(printf '%s' "$msg" | python -c 'import json,sys; print(json.dumps(sys.stdin.read()))')" \
    >> "$file" 2>/dev/null || true
  # Optional active notifier
  if [[ -x "$HOME/Pickleball/bin/exc-notify" ]]; then
    "$HOME/Pickleball/bin/exc-notify" --tool rp --level "$level" --message "$msg" || true
  fi
}

trap 'notify_excalibur error "rp failed (exit=$?, line=$BASH_LINENO, cmd=${BASH_COMMAND})"; exit 1' ERR

# ---------- helpers ----------
clip() {
  if command -v termux-clipboard-get >/dev/null 2>&1; then termux-clipboard-get
  elif command -v pbpaste >/dev/null 2>&1; then pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then wl-paste
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o
  elif command -v xsel >/dev/null 2>&1; then xsel --clipboard --output
  else echo "No clipboard tool found." >&2; exit 1; fi
}

trim_ws() {
  local s="${1:-}"
  s="${s//$'\r'/}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

clean_marker() {
  local s; s="$(trim_ws "$1")"
  s="${s#\`\`\`}"   # strip leading ```
  s="${s%\`\`\`}"   # strip trailing ```
  case "$s" in \#*) s="${s#\#}"; s="$(trim_ws "$s")" ;; esac
  printf '%s' "$s"
}

repo_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -d "$d/.git" ]]; then echo "$d"; return 0; fi
    d="$(dirname -- "$d")"
  done
  return 1
}

resolve_path() {
  local p; p="$(clean_marker "$1")"
  [[ "${p:0:1}" == "~" ]] && p="${HOME}${p:1}"
  if [[ "$p" == /* ]]; then echo "$p"; return 0; fi
  local top="${p%%/*}"; [[ -z "$top" ]] && top="$p"
  local tail=""; [[ "$p" == */* ]] && tail="${p#*/}"

  local bases=()
  bases+=("$HOME/HouseOfYes")
  if root="$(repo_root 2>/dev/null || true)"; then bases+=("$root"); fi
  bases+=("$PWD" "$HOME/Pickleball")

  local alt1="${top//_/-}"
  local alt2="${top//-/_}"

  local base
  for base in "${bases[@]}"; do
    if [[ -d "$base/$top" ]]; then
      [[ -n "$tail" ]] && { echo "$base/$top/$tail"; return 0; } || { echo "$base/$top"; return 0; }
    fi
    if [[ "$alt1" != "$top" && -d "$base/$alt1" ]]; then
      [[ -n "$tail" ]] && { echo "$base/$alt1/$tail"; return 0; } || { echo "$base/$alt1"; return 0; }
    fi
    if [[ "$alt2" != "$top" && -d "$base/$alt2" ]]; then
      [[ -n "$tail" ]] && { echo "$base/$alt2/$tail"; return 0; } || { echo "$base/$alt2"; return 0; }
    fi
  done
  # Fallback: relative to PWD
  [[ -n "$tail" ]] && echo "$PWD/$top/$tail" || echo "$PWD/$top"
}

# ---------- main ----------
if [[ $# -eq 1 ]]; then
  file="$(resolve_path "$1")"
  dir="$(dirname -- "$file")"; mkdir -p -- "$dir"
  if [[ $backup -eq 1 && -e "$file" ]]; then
    cp -p -- "$file" "${file}.bak.$(date +%Y%m%d-%H%M%S)"
  fi
  ( clip || true ) > "$file"
  rel="$(realpath --relative-to=. "$file" 2>/dev/null || printf '%s' "$file")"
  bytes="$(wc -c < "$file" | tr -d '[:space:]')"
  printf '%s (%s bytes)\n' "$rel" "$bytes"
  [[ $do_cat -eq 1 ]] && { echo "-----"; cat -- "$file"; }
  exit 0
fi

[[ $# -eq 0 ]] || usage

tmp="$(mktemp)"; trap 'rm -f "$tmp" || true' EXIT
( clip || true ) > "$tmp"

first_line_raw="$(grep -m1 -v '^[[:space:]]*$' "$tmp" || true)"
first_line="$(clean_marker "${first_line_raw:-}")"

if [[ -z "${first_line:-}" ]]; then
  echo "Clipboard empty (no target filename found on first non-blank line)." >&2
  exit 1
fi

file="$(resolve_path "$first_line")"

if [[ $auto_yes -eq 0 ]]; then
  # Default YES on Enter
  read -r -p "Replace '${file}' with clipboard content (excluding first line)? [Y/n] " ans || true
  case "${ans:-}" in
    n|N|no|NO) echo "Aborted."; exit 1 ;;
    *) : ;; # default yes
  esac
fi

dir="$(dirname -- "$file")"; mkdir -p -- "$dir"
if [[ $backup -eq 1 && -e "$file" ]]; then
  cp -p -- "$file" "${file}.bak.$(date +%Y%m%d-%H%M%S)"
fi

# write everything except the first nonblank line
awk 'f||NF{ if(!f){f=1; next} print }' "$tmp" > "$file" || : > "$file"

rel="$(realpath --relative-to=. "$file" 2>/dev/null || printf '%s' "$file")"
bytes="$(wc -c < "$file" | tr -d '[:space:]')"
printf '%s (%s bytes)\n' "$rel" "$bytes"

[[ $do_cat -eq 1 ]] && { echo "-----"; cat -- "$file"; }

# optional hook
if [[ $run_tests -eq 1 ]]; then
  : # reserved; add your project-specific selftests here if needed
fi

exit 0
